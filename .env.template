# Django
DEBUG=True
ALLOWED_HOSTS=*
ADMIN_CENTINELA=
PASSWORD_CENTINELA=

# Neo4j interno del docker-compose.yaml
NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_SCHEME=bolt
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me

# Mongo interno del docker-compose.yaml
MONGO_DB_HOST=mongo
MONGO_DB_PORT=27017
MONGO_DB_NAME=centinela
MONGO_DB_USERNAME=centinela
MONGO_DB_PASSWORD=change-me
MONGO_AUTH_SOURCE=admin

# Elsevier / Scopus
X_ELS_APIKEY=
X_ELS_INSTTOKEN=
X_ELS_AUTHTOKEN=
SCOPUS_USE_INSTTOKEN=False
SCOPUS_USE_AUTHTOKEN=False
SCOPUS_EXTRACTION_DEFAULT_MAX_PAGES=10
SCOPUS_DEFAULT_QUERY=AFFIL(AFFILCOUNTRY(ECUADOR))
SCOPUS_PAYLOAD_VERSION=2026-06-24

# Medallion Scopus
SCOPUS_MEDALLION_DB_NAME=ETL_Centinela_refactor
SCOPUS_RAW_ARTICLES_COLLECTION=raw_data
SCOPUS_RAW_AUTHORS_COLLECTION=raw_authors
SCOPUS_RAW_AFFILIATIONS_COLLECTION=raw_affiliations
SCOPUS_CURSORS_COLLECTION=cursors
SCOPUS_SILVER_ARTICLES_COLLECTION=silver_articles
SCOPUS_SILVER_AUTHORS_COLLECTION=silver_authors
SCOPUS_SILVER_AFFILIATIONS_COLLECTION=silver_affiliations
SCOPUS_GOLD_ML_FEATURES_COLLECTION=gold_ml_features
SCOPUS_GOLD_GRAPH_ENTITIES_COLLECTION=gold_graph_entities
SCOPUS_GOLD_DASHBOARD_METRICS_COLLECTION=gold_dashboard_metrics

# Microservicio ML. Dentro de Docker debe usar el alias de red.
USE_ML_MODELS_SERVICE=True
ML_MODELS_BASE_URL=http://ms-ml-models:8000
ML_MODELS_TIMEOUT_SECONDS=120
